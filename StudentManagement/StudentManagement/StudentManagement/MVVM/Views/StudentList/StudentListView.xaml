<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="StudentManagement.MVVM.Views.StudentList.StudentListView"
             xmlns:models="clr-namespace:StudentManagement.MVVM.Models.StudentList"
             xmlns:vm="clr-namespace:StudentManagement.MVVM.ViewModels.StudentList"
             x:DataType="vm:StudentListViewModel"
             Title="Students">

    <Grid RowDefinitions="Auto,*,Auto" Padding="15">

        <!-- Table Header -->
        <Border Grid.Row="0" BackgroundColor="#512BD4" Padding="10" StrokeThickness="0" Margin="0,0,0,5">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="5,5,0,0" />
            </Border.StrokeShape>
            <!-- Name | Email | Department | Actions -->
            <Grid ColumnDefinitions="*,2*,*,Auto">
                <Label Text="Name"       FontAttributes="Bold" TextColor="White" />
                <Label Grid.Column="1"   Text="Email"      FontAttributes="Bold" TextColor="White" />
                <Label Grid.Column="2"   Text="Department" FontAttributes="Bold" TextColor="White" />
                <Label Grid.Column="3"   Text="Actions"    FontAttributes="Bold" TextColor="White" />
            </Grid>
        </Border>

        <!-- Table Body -->
        <CollectionView Grid.Row="1" ItemsSource="{Binding Students}">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:StudentDTO">
                    <Border Stroke="#E0E0E0" StrokeThickness="1" Padding="10" Margin="0,0,0,-1">
                        <Grid ColumnDefinitions="*,2*,*,Auto" RowDefinitions="Auto">

                            <Label Text="{Binding Name}"
                                   VerticalOptions="Center"
                                   TextColor="#333333"
                                   FontAttributes="Bold" />

                            <Label Grid.Column="1"
                                   Text="{Binding Email}"
                                   VerticalOptions="Center"
                                   TextColor="#666666" />

                            <Label Grid.Column="2"
                                   Text="{Binding Department}"
                                   VerticalOptions="Center"
                                   TextColor="#512BD4" />

                            <!-- Edit / Delete action buttons -->
                            <HorizontalStackLayout Grid.Column="3" Spacing="6" VerticalOptions="Center">

                                <Button Text="✏️ Edit"
                                        FontSize="12"
                                        HeightRequest="34"
                                        Padding="8,0"
                                        CornerRadius="6"
                                        BackgroundColor="#512BD4"
                                        TextColor="White"
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type vm:StudentListViewModel}}, Path=EditStudentCommand}"
                                        CommandParameter="{Binding .}" />

                                <Button Text="🗑️ Delete"
                                        FontSize="12"
                                        HeightRequest="34"
                                        Padding="8,0"
                                        CornerRadius="6"
                                        BackgroundColor="#D32F2F"
                                        TextColor="White"
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type vm:StudentListViewModel}}, Path=DeleteStudentCommand}"
                                        CommandParameter="{Binding .}" />

                            </HorizontalStackLayout>
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>

            <CollectionView.EmptyView>
                <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center" Spacing="10" Padding="20">
                    <Label Text="No students found."
                           FontSize="18"
                           HorizontalOptions="Center"
                           TextColor="#999999" />
                </VerticalStackLayout>
            </CollectionView.EmptyView>
        </CollectionView>

        <!-- Add Student Button -->
        <Button Grid.Row="2"
                Text="＋ Add Student"
                Command="{Binding AddStudentCommand}"
                Margin="0,20,0,0"
                CornerRadius="25"
                HeightRequest="50"
                FontSize="18"
                BackgroundColor="#512BD4"
                TextColor="White"
                FontAttributes="Bold" />
    </Grid>
</ContentPage>