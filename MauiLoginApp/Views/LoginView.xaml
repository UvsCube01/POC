<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:MauiLoginApp.ViewModels"
             x:Class="MauiLoginApp.Views.LoginView"
             Shell.NavBarIsVisible="False">



    <Grid BackgroundColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource Black}}">
        <!-- Background Gradient
        <BoxView IsVisible="{AppThemeBinding Light=True, Dark=False}">
            <BoxView.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#6200EE" Offset="0.1" />
                    <GradientStop Color="#03DAC6" Offset="1.0" />
                </LinearGradientBrush>
            </BoxView.Background>
        </BoxView>

        <BoxView IsVisible="{AppThemeBinding Light=False, Dark=True}">
            <BoxView.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#121212" Offset="0.1" />
                    <GradientStop Color="#1F1B24" Offset="1.0" />
                </LinearGradientBrush>
            </BoxView.Background>
        </BoxView> -->

        <ScrollView VerticalOptions="Center">
            <VerticalStackLayout Spacing="20" Padding="30" VerticalOptions="Center">
                
                <!-- Logo/Icon -->
                <Image Source="dotnet_bot.png" 
                       HeightRequest="150" 
                       HorizontalOptions="Center" 
                       Margin="0,0,0,20">
                    <Image.Shadow>
                        <Shadow Brush="Black" Offset="5,5" Radius="10" Opacity="0.3"/>
                    </Image.Shadow>
                </Image>

                <Label Text="Welcome Back" 
                       FontSize="32" 
                       FontAttributes="Bold" 
                       TextColor="White" 
                       HorizontalOptions="Center" />

                <Label Text="Login to your account" 
                       FontSize="16" 
                       TextColor="White" 
                       Opacity="0.8"
                       HorizontalOptions="Center" 
                       Margin="0,0,0,30" />

                <!-- Login Card -->
                <Frame CornerRadius="20" 
                       Padding="20" 
                       BackgroundColor="{AppThemeBinding Light=#AAFFFFFF, Dark=#22FFFFFF}"
                       BorderColor="Transparent" 
                       HasShadow="True">
                    
                    <VerticalStackLayout Spacing="15">
                        <Entry x:Name="UsernameEntry"
                               Placeholder="Username" 
                               Text="{Binding Username}" 
                               PlaceholderColor="Gray"
                               TextColor="{AppThemeBinding Light=Black, Dark=White}"
                               BackgroundColor="Transparent" />

                        <Entry x:Name="PasswordEntry"
                               Placeholder="Password" 
                               Text="{Binding Password}" 
                               IsPassword="True" 
                               PlaceholderColor="Gray"
                               TextColor="{AppThemeBinding Light=Black, Dark=White}"
                               BackgroundColor="Transparent" />

                        <Button x:Name="LoginButton"
                                Text="LOGIN" 
                                Command="{Binding LoginCommand}" 
                                BackgroundColor="#6200EE" 
                                TextColor="White" 
                                FontAttributes="Bold"
                                CornerRadius="25" 
                                HeightRequest="50"
                                Margin="0,10,0,0" />
                                <!-- To use Code-Behind, uncomment below and comment Command above -->
                                <!-- Clicked="OnLoginClicked" -->

                        <ActivityIndicator x:Name="LoginLoadingIndicator"
                                           IsRunning="{Binding IsBusy}" 
                                           HorizontalOptions="Center" 
                                           Color="White" />
                    </VerticalStackLayout>
                </Frame>

                <HorizontalStackLayout HorizontalOptions="Center" Spacing="5" Margin="0,20,0,0">
                    <Label Text="Don't have an account?" TextColor="White" Opacity="0.8"/>
                    <Label Text="Register Now" 
                           TextColor="White" 
                           FontAttributes="Bold" 
                           TextDecorations="Underline">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding GoToRegisterCommand}" />
                            <!-- To use Code-Behind, uncomment below and comment Command above -->
                            <!-- <TapGestureRecognizer Tapped="OnRegisterTapped" /> -->
                        </Label.GestureRecognizers>
                    </Label>
                </HorizontalStackLayout>

            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
